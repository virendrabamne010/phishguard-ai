# PhishGuard AI — Production Environment Variables
# Use this file when deploying via Docker Compose in a production environment.

ENVIRONMENT=production
DEBUG=False

# Replace with a strong, randomly generated 64-character secret key
SECRET_KEY=generate_a_secure_random_key_here_for_production_jwt

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# PostgreSQL Database Configuration
# This is automatically used by docker-compose.yml
POSTGRES_USER=phishguard
POSTGRES_PASSWORD=secure_db_password_here
POSTGRES_DB=phishguard
DATABASE_URL=postgresql://phishguard:secure_db_password_here@db:5432/phishguard

# Security & CORS
FRONTEND_URL=https://phishguard.yourdomain.com
CORS_ORIGINS=https://phishguard.yourdomain.com
TRUSTED_HOSTS=phishguard.yourdomain.com,api.phishguard.yourdomain.com
