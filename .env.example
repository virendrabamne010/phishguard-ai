# PhishGuard AI — Root Environment Variables
# Copy this file to .env and fill in real values before deploying.

# ───────────────────────────────────────────────────────
# REQUIRED for production (no defaults)
# ───────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-256-bit-random-secret-key
ADMIN_PASSWORD=replace-with-a-secure-password
POSTGRES_PASSWORD=replace-with-a-secure-db-password

# ───────────────────────────────────────────────────────
# Optional — defaults shown
# ───────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=False
ADMIN_USERNAME=admin

# Database (auto-built from POSTGRES_PASSWORD if not set)
# DATABASE_URL=postgresql://phishguard:yourpassword@db:5432/phishguard

# Frontend URL (used for OAuth redirect)
FRONTEND_URL=http://localhost:5173
REDIRECT_URI=http://localhost:8000/inbox/oauth/callback

# Comma-separated allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
