# PhishGuard AI — Backend environment template
# Copy this file to `.env` and fill in your own values.

ENVIRONMENT=development
DEBUG=False
PORT=8000
HOST=0.0.0.0

# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# PostgreSQL (Production-grade)
# DATABASE_URL=postgresql://user:password@localhost:5432/phishguard

# SQLite fallback (quick local dev without PostgreSQL)
DATABASE_URL=sqlite:///./data/phishguard.db

FRONTEND_URL=http://localhost:5173
REDIRECT_URI=http://localhost:8000/inbox/oauth/callback
